# =============================================
# CURRIFY PRODUCTION ENVIRONMENT TEMPLATE
# =============================================
#
# INSTRUCCIONES PARA PRODUCCIÓN:
# 1. Copia este archivo como ".env.production":
#    cp .env.production.template .env.production
# 2. Rellena TODAS las contraseñas, claves secretas y APIs
# 3. NUNCA subas el archivo .env.production real a GitHub
# =============================================

# =============================================
# CURRIFY-CORE (FastAPI Service)
# =============================================
LLM_PROVIDER=google
ANTHROPIC_API_KEY=your_production_anthropic_key_here
OPENAI_API_KEY=your_production_openai_key_here
GOOGLE_API_KEY=your_production_google_key_here
GROQ_API_KEY=your_production_groq_key_here

CLAUDE_MODEL=claude-3-haiku-20240307
OPENAI_MODEL=gpt-4
GOOGLE_MODEL=gemini-2.0-flash
GROQ_MODEL=openai/gpt-oss-120b

MAX_TOKENS=2048
TIMEOUT_SECONDS=60.0

# CAMBIAR ESTAS CREDENCIALES EN PRODUCCIÓN
ADMIN_USERNAME=admin_prod_user
ADMIN_PASSWORD=change_this_password_immediately!
VALID_API_KEYS=prod-key-1,prod-key-2
API_SECRET_KEY=generate_a_long_random_string_here_for_jwt

# CORS (Dominio final del Frontend, ej: https://app.currify.cl)
ALLOWED_ORIGINS=https://currify-frontend-4yfulzoska-uc.a.run.app,http://localhost:3000

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
ENVIRONMENT=production
DEBUG=false

# =============================================
# CURRIFY-BACK (NestJS Backend)
# =============================================
# Base de datos. Las credenciales deben coincidir con las de "GENERALES" abajo
DATABASE_URL=postgresql://currify_admin:strong_db_password_here@postgres:5432/currify_prod_db

# Seguridad JWT
JWT_SECRET=super_secret_production_jwt_key_change_me
JWT_EXPIRES_IN=30d

# OAuth APIs
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# IMPORTANTE: Configura la URL exacta autorizada en Google Cloud Console
GOOGLE_CALLBACK_URL=https://currify-backend-4yfulzoska-uc.a.run.app/api/auth/google/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

AI_API_KEY=
AI_API_URL=

# Core Integrations (Nombre del contenedor en docker-compose)
SCORING_SERVICE_URL=http://currify-core:8000
SCORING_SERVICE_USERNAME=admin_prod_user
SCORING_SERVICE_PASSWORD=change_this_password_immediately!
SCORING_SERVICE_API_KEY=

# Servidor de Correo (SMTP)
FRONTEND_URL=https://currify-frontend-4yfulzoska-uc.a.run.app
SMTP_HOST=smtp.tu-servidor-correo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@tu-dominio.com
SMTP_PASS=tu_contraseña_smtp
SMTP_FROM_NAME="Currify Evaluaciones"
SMTP_FROM_EMAIL=no-reply@tu-dominio.com

# Stripe Pagos
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID_PRO=price_...

# =============================================
# VARIABLES COMUNES/GENERALES (Docker y DB)
# =============================================
POSTGRES_DB=currify_prod_db
POSTGRES_USER=currify_admin
POSTGRES_PASSWORD=strong_db_password_here

NODE_ENV=production

# URLs consumidas por el Frontend en Tiempo de Compilación
REACT_APP_API_URL=https://currify-backend-4yfulzoska-uc.a.run.app/api
REACT_APP_SCORING_SERVICE_URL=/api/scoring
REACT_APP_MAPBOX_TOKEN=your_mapbox_token_here
