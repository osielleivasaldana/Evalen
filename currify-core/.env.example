# ============================================================
# CURRIFY - Environment Configuration
# ============================================================
# IMPORTANTE: No usar valores por defecto en producción.
# Todos los secretos DEBEN configurarse mediante variables de entorno.
# ============================================================

# LLM Provider: "google", "anthropic" o "openai"
LLM_PROVIDER=google

# API Keys (solo necesitas configurar la del provider seleccionado)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model Configuration
GOOGLE_MODEL=gemini-2.0-flash
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o

# General LLM settings
MAX_TOKENS=4096
TIMEOUT_SECONDS=120.0
LLM_CONCURRENCY_LIMIT=3

# ============================================================
# SEGURIDAD (OBLIGATORIO EN PRODUCCIÓN)
# ============================================================

# JWT Secret Key: generar con `openssl rand -hex 32`
# En producción, NUNCA usar valores hardcodeados
CURRIFY_SECRET_KEY=

# CORS Origins (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ============================================================
# AUTENTICACIÓN
# ============================================================

# Admin credentials
# Password en producción debe ser un hash bcrypt: generar con passlib
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# API Keys (bcrypt hashes separados por coma)
# Generar con: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('tu-api-key'))"
VALID_API_KEYS=

# ============================================================
# RATE LIMITING
# ============================================================

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================================
# ENVIRONMENT
# ============================================================

ENVIRONMENT=development
DEBUG=false

# ============================================================
# CURRIFY SPECIFIC
# ============================================================

MAX_FILE_SIZE_MB=10
MAX_BATCH_SIZE=50
SUPPORTED_FILE_FORMATS=pdf,docx,doc,txt,rtf
