DATABASE_URL="postgresql://username:password@localhost:5432/evalen_db"
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Google OAuth (required for Google Sign-In)
# Get these from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Frontend URL (for email links and OAuth redirect)
FRONTEND_URL="http://localhost:3000"

# SMTP Configuration (for sending emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM_NAME="Currify"
SMTP_FROM_EMAIL="noreply@evalen.com"

# LinkedIn API (opcional)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DEST="./uploads"
STORAGE_TYPE="local" # 'local' o 'gcs'
GCS_BUCKET_NAME="" # requerido solo si STORAGE_TYPE="gcs"

# AI Processing (si usas una API externa)
AI_API_KEY=""
AI_API_URL=""

# Scoring Service
SCORING_SERVICE_URL="http://localhost:8000"
SCORING_SERVICE_USERNAME=""
SCORING_SERVICE_PASSWORD=""
SCORING_SERVICE_API_KEY=""