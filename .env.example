# =============================================
# VARIABLES DE ENTORNO PARA CURRIFY
# =============================================
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Rellena los valores con tus credenciales reales
# 3. NUNCA subas el archivo .env a GitHub
#
# =============================================

# =============================================
# CURRIFY-CORE (FastAPI Service)
# =============================================
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

CLAUDE_MODEL=claude-3-haiku-20240307
OPENAI_MODEL=gpt-4
GOOGLE_MODEL=gemini-1.5-pro

MAX_TOKENS=2048
TIMEOUT_SECONDS=60.0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
VALID_API_KEYS=prod-key-12345,backup-key-67890
API_SECRET_KEY=generate_a_secure_random_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

ENVIRONMENT=production
DEBUG=false

# =============================================
# CURRIFY-BACK (NestJS Backend)
# =============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/currify_db

JWT_SECRET=generate_a_secure_jwt_secret_here
JWT_EXPIRES_IN=7d

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

AI_API_KEY=
AI_API_URL=

SCORING_SERVICE_URL=http://localhost:8000
SCORING_SERVICE_USERNAME=admin
SCORING_SERVICE_PASSWORD=change_this_password
SCORING_SERVICE_API_KEY=

# =============================================
# CURRIFY-FRONT (React Frontend)
# =============================================
REACT_APP_API_URL=http://localhost:3001
REACT_APP_SCORING_SERVICE_URL=http://localhost:8000
REACT_APP_MAPBOX_TOKEN=your_mapbox_token_here

# =============================================
# DATABASE (PostgreSQL)
# =============================================
POSTGRES_DB=currify_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

NODE_ENV=production

# =============================================
# BILLING / PAYMENTS CONFIGURATION
# =============================================
# Gateway options: stripe, mercadopago
PAYMENT_GATEWAY=stripe

# Stripe Settings
STRIPE_SECRET_KEY=dummy
STRIPE_PRICE_ID_PRO=price_dummy_pro
STRIPE_WEBHOOK_SECRET=

# Mercado Pago Settings
# For Chile / Local currency, use Chilean Mercado Pago credentials
MERCADOPAGO_ACCESS_TOKEN=dummy
