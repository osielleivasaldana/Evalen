FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
# Install dependencies with legacy peer deps to avoid conflicts
RUN npm install --legacy-peer-deps --no-audit --no-fund

# Copy source code (optional, as volume will override, but good for caching)
COPY . .

# Expose port
EXPOSE 3000

# Increase memory limit for Node.js (Optimized for 16GB RAM system)
ENV NODE_OPTIONS="--max-old-space-size=2048"

# Start development server
# Start development server
# Polling disabled to save memory (WSL2 events should work)
ENV CHOKIDAR_USEPOLLING=false
ENV WATCHPACK_POLLING=true

CMD ["npm", "start"]
