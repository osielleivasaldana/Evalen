FROM node:18-alpine

WORKDIR /app

# Copy package files FIRST (before any source code)
COPY package*.json ./

# Install dependencies - these will be preserved in the named volume
RUN npm install --legacy-peer-deps --no-audit --no-fund

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Increase memory limit for Node.js (Optimized for 16GB RAM system)
ENV NODE_OPTIONS="--max-old-space-size=2048"

# Start development server
ENV CHOKIDAR_USEPOLLING=false
ENV WATCHPACK_POLLING=true

CMD ["npm", "start"]
